plot "out/urban_plume2_0001_gas.txt" using ($1/3600):12 axes x1y1 with lines title "O3", \
     "out/urban_plume2_0001_gas.txt" using ($1/3600):7 axes x1y1 with lines title "NO2"

plot "out/urban_plume2_0001_gas.txt" using ($1/3600):3 axes x1y1 with lines title "HNO3", \
     "out/urban_plume2_0001_gas.txt" using ($1/3600):24 axes x1y1 with lines title "HCHO", \
